---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/ui';
import { ayudaData } from '../../../data/ayuda';

export function getStaticPaths() {
  const langs = ['es', 'en', 'pt'];
  const subcategories = [
    { id: 'info-util', es: 'Información útil', en: 'Useful info', pt: 'Informação útil' },
    { id: 'seguridad', es: 'Seguridad', en: 'Security', pt: 'Segurança' },
    { id: 'faqs', es: 'Preguntas Frecuentes', en: 'FAQs', pt: 'FAQs' },
  ];

  return langs.flatMap(lang => 
    subcategories.map(sub => ({
      params: { lang, subcategory: sub.id },
      props: { title: sub[lang as 'es'|'en'|'pt'], id: sub.id }
    }))
  );
}

const { lang } = Astro.params;
const { title, id } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');
const isES = lang === 'es';

const loc = (obj: any) => obj?.[lang as keyof typeof obj] || obj?.en || '';

// Get the specific data array based on the subcategory ID
const contentData = ayudaData[id as keyof typeof ayudaData];
---

<Layout title={`${title} | Ayuda | RecorreSantiago`} lang={lang as 'es' | 'en'}>
	<div class="page-header">
		<div class="container">
			<a href={`/${lang}/ayuda`} class="back-link">
				<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
				{isES ? 'Volver a Ayuda' : 'Back to Help'}
			</a>
			<h1>{title}</h1>
			<p>{isES ? `Encuentra todo sobre ${title.toLowerCase()}.` : `Find everything about ${title.toLowerCase()}.`}</p>
		</div>
	</div>

	<section class="content-section">
		<div class="container">
			
			{/* Render Information or Security Cards */}
			{(id === 'info-util' || id === 'seguridad') && (
				<div class="cards-grid">
					{(contentData as any[]).map((item) => (
						<article class="info-card">
							<div class="card-icon" set:html={item.icon} />
							<h3>{loc(item.title)}</h3>
							<p>{loc(item.desc)}</p>
						</article>
					))}
				</div>
			)}

			{/* Render FAQs as Accordion */}
			{id === 'faqs' && (
				<div class="faq-list">
					{(contentData as any[]).map((faq) => (
						<details class="faq-item">
							<summary class="faq-question">
								{loc(faq.q)}
								<span class="faq-icon">+</span>
							</summary>
							<div class="faq-answer">
								<p>{loc(faq.a)}</p>
							</div>
						</details>
					))}
				</div>
			)}

		</div>
	</section>
</Layout>

<style>
	/* HEADER */
	.page-header {
		background: var(--surface-color);
		color: var(--text-color);
		padding: 5rem 2.5rem 4rem;
		text-align: center;
		border-bottom: 1px solid var(--border-color);
	}
	
	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		margin-bottom: 2rem;
		transition: color 0.3s;
	}
	.back-link:hover { color: var(--text-color); }

	.page-header h1 {
		font-family: 'Playfair Display', serif;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 900;
		margin-bottom: 1rem;
	}
	
	.page-header p {
		font-size: 1.15rem;
		color: var(--text-muted);
		max-width: 600px;
		margin: 0 auto;
	}

	.container {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 2.5rem;
	}

	.content-section {
		padding-block: 5rem;
		background: var(--bg-color);
		min-height: 50vh;
	}

	/* CARDS GRID (INFO & SECURITY) */
	.cards-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}
	
	.info-card {
		background: rgba(255, 255, 255, 0.02);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		padding: 2.5rem 2rem;
		transition: transform 0.3s, border-color 0.3s, background 0.3s;
	}
	.info-card:hover {
		transform: translateY(-5px);
		border-color: rgba(225, 29, 72, 0.5); /* Rose-600 */
	}

	.card-icon {
		font-size: 3rem;
		margin-bottom: 1.5rem;
		background: rgba(255, 255, 255, 0.05);
		width: 70px;
		height: 70px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.info-card h3 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.4rem;
		color: #ffffff;
		margin-bottom: 1rem;
	}

	.info-card p {
		font-size: 1.05rem;
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.6;
	}

	/* FAQ ACCORDION */
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.faq-item {
		background: rgba(255, 255, 255, 0.02);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		overflow: hidden;
	}

	.faq-question {
		padding: 1.5rem 2rem;
		font-family: 'Outfit', sans-serif;
		font-size: 1.2rem;
		font-weight: 600;
		color: #ffffff;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		list-style: none; /* Hide default arrow */
	}
	/* Safari specific to hide arrow */
	.faq-question::-webkit-details-marker { display: none; }

	.faq-question:hover {
		background: rgba(255, 255, 255, 0.04);
	}

	.faq-icon {
		font-size: 1.5rem;
		font-weight: 300;
		transition: transform 0.3s ease;
		color: #e11d48;
	}

	details[open] .faq-icon {
		transform: rotate(45deg); /* Turn + into x */
	}

	.faq-answer {
		padding: 0 2rem 2rem 2rem;
		font-size: 1.05rem;
		color: rgba(255, 255, 255, 0.7);
		line-height: 1.6;
		border-top: 1px solid transparent;
		animation: slideDown 0.3s ease-out;
	}
	
	details[open] .faq-answer {
		border-top-color: rgba(255, 255, 255, 0.05);
		padding-top: 1.5rem;
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>
