---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/ui';

export function getStaticPaths() {
  const langs = ['es', 'en'];
  const subcategories = [
    { id: 'info-util', es: 'Información útil', en: 'Useful info' },
    { id: 'seguridad', es: 'Seguridad', en: 'Security' },
    { id: 'faqs', es: 'Preguntas Frecuentes', en: 'FAQs' },
  ];

  return langs.flatMap(lang => 
    subcategories.map(sub => ({
      params: { lang, subcategory: sub.id },
      props: { title: sub[lang as 'es'|'en'] }
    }))
  );
}

const { lang } = Astro.params;
const { title } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');
---
<Layout title={`${title} | Ayuda | RecorreChile`} lang={lang as 'es' | 'en'}>
	<div class="page-header">
		<div class="container">
			<h1>{title}</h1>
			<p>{lang === 'es' ? `Encuentra todo sobre ${title.toLowerCase()}.` : `Find everything about ${title.toLowerCase()}.`}</p>
		</div>
	</div>

	<section class="content-section">
		<div class="container">
			<div class="placeholder-content">
				<p>{lang === 'es' ? 'El contenido de esta sección se generará dinámicamente desde el CMS pronto.' : 'The content for this section will be generated dynamically from the CMS soon.'}</p>
				<a href={`/${lang}/ayuda`} class="btn btn-outline">{lang === 'es' ? 'Volver a Ayuda' : 'Back to Help'}</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.page-header {
		background: linear-gradient(135deg, #475569, #1E293B);
		color: white;
		padding: 5rem 1.5rem 3rem;
		text-align: center;
	}
	
	.page-header h1 {
		font-size: clamp(2rem, 4vw, 3.5rem);
		font-weight: 700;
		margin-bottom: 1rem;
	}
	
	.page-header p {
		font-size: 1.125rem;
		opacity: 0.9;
		max-width: 600px;
		margin: 0 auto;
	}

	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	.content-section {
		padding: 5rem 0;
	}

	.placeholder-content {
		text-align: center;
		padding: 4rem;
		background: var(--surface-color);
		border-radius: 20px;
		border: 1px dashed var(--border-color);
	}

	.placeholder-content p {
		font-size: 1.25rem;
		color: var(--text-secondary);
		margin-bottom: 2rem;
	}

	.btn-outline {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		color: #475569;
		border: 2px solid #475569;
		transition: all 0.3s ease;
	}

	.btn-outline:hover {
		background: #475569;
		color: white;
	}
</style>
