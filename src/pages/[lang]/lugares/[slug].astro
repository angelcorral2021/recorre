---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const lugares = await getCollection('lugares');
  return lugares.map(lugar => {
    const [lang, ...slugParts] = lugar.id.split('/');
    const slug = slugParts.join('/').replace('.md', '');
    return {
      params: { lang, slug },
      props: { lugar },
    };
  });
}

const { lang } = Astro.params;
const { lugar } = Astro.props;
const { Content } = await render(lugar);

const contactText = lang === 'es' ? 'Contacto por WhatsApp' : 'Contact via WhatsApp';
---

<Layout title={lugar.data.titulo} lang={lang as 'es' | 'en'}>
	<article class="place-detail">
		<header class="hero-header">
			<Image 
				src={lugar.data.imagen_principal} 
				alt={lugar.data.titulo}
				width={1200}
				height={800}
				class="hero-img"
				format="webp"
				quality={85}
			/>
			<div class="header-overlay">
				<a href={`/${lang}/`} class="back-btn">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					{lang === 'es' ? 'Volver' : 'Back'}
				</a>
				<div class="header-content">
					<span class="category-badge">{lugar.data.categoria}</span>
					<h1>{lugar.data.titulo}</h1>
				</div>
			</div>
		</header>

		<div class="content-wrapper">
			<div class="meta-info">
				<div class="meta-item">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
					<span>{lugar.data.horario}</span>
				</div>
				<div class="meta-item">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
					<span>{lugar.data.precio}</span>
				</div>
				<a href={lugar.data.ubicacion_maps} target="_blank" rel="noopener noreferrer" class="meta-item map-link">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					<span>{lang === 'es' ? 'Ver en Mapa' : 'View on Map'}</span>
				</a>
			</div>

			<div class="storytelling">
				<p class="lead">{lugar.data.descripcion_corta}</p>
				<div class="prose">
					<Content />
				</div>
			</div>

			{lugar.data.galeria && lugar.data.galeria.length > 0 && (
				<div class="gallery">
					<h3>{lang === 'es' ? 'Galería' : 'Gallery'}</h3>
					<div class="gallery-grid">
						{lugar.data.galeria.map((img) => (
							<Image 
								src={img} 
								alt={`Gallery image of ${lugar.data.titulo}`}
								width={400}
								height={400}
								class="gallery-img"
								format="webp"
								quality={80}
							/>
						))}
					</div>
				</div>
			)}

			{lugar.data.video_youtube && (
				<div class="video-section">
					<h3>{lang === 'es' ? 'Video Destacado' : 'Featured Video'}</h3>
					<div class="video-container">
						<iframe 
							src={lugar.data.video_youtube.replace("watch?v=", "embed/")} 
							title="YouTube video player" 
							frameborder="0" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen>
						</iframe>
					</div>
				</div>
			)}

			<div class="action-section">
				{/* Placeholder for future WhatsApp integration */}
				<button class="btn-primary">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
					{contactText}
				</button>
			</div>
		</div>
	</article>
</Layout>

<style>
	.place-detail {
		background: var(--bg-color);
	}

	.hero-header {
		position: relative;
		height: 60vh;
		min-height: 400px;
	}

	.hero-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.header-overlay {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, transparent 20%, transparent 60%, rgba(0,0,0,0.8) 100%);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1.5rem;
		color: white;
	}

	.back-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: white;
		text-decoration: none;
		font-weight: 500;
		text-shadow: 0 1px 2px rgba(0,0,0,0.5);
		margin-top: 1rem;
	}

	.header-content {
		padding-bottom: 1rem;
	}

	.category-badge {
		background: var(--color-secondary);
		color: white;
		padding: 0.25rem 0.75rem;
		border-radius: 999px;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		margin-bottom: 1rem;
		display: inline-block;
	}

	.header-content h1 {
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.1;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.content-wrapper {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem 1.5rem;
	}

	.meta-info {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border-color);
		margin-bottom: 2rem;
	}

	.meta-item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-secondary);
		font-size: 0.875rem;
	}

	.map-link {
		color: var(--color-tertiary);
		text-decoration: none;
		font-weight: 500;
	}

	.storytelling .lead {
		font-size: 1.25rem;
		line-height: 1.6;
		color: var(--text-primary);
		font-weight: 400;
		margin-bottom: 2rem;
	}

	.prose {
		font-size: 1.0625rem;
		line-height: 1.7;
		color: var(--text-secondary);
		margin-bottom: 3rem;
	}

	.gallery {
		margin-bottom: 3rem;
	}

	.gallery h3 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		color: var(--text-primary);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: 1rem;
	}

	.gallery-img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 12px;
	}

	.video-section {
		margin-bottom: 3rem;
	}

	.video-section h3 {
		font-size: 1.5rem;
		margin-bottom: 1.5rem;
		color: var(--text-primary);
	}

	.video-container {
		position: relative;
		width: 100%;
		padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
		border-radius: 12px;
		overflow: hidden;
		background-color: #000;
	}

	.video-container iframe {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.action-section {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border-color);
		text-align: center;
	}

	.btn-primary {
		background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
		color: white;
		border: none;
		padding: 1rem 2rem;
		border-radius: 999px;
		font-size: 1.125rem;
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		font-family: inherit;
	}

	.btn-primary:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 20px rgba(37, 211, 102, 0.3);
	}

	@media (min-width: 768px) {
		.back-btn {
			margin-top: 2rem;
		}
	}
</style>
