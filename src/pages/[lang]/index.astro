---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

const pageTitle = 'Recorre Santiago';
const subtitle = lang === 'es'
  ? 'Encuentra destinos increíbles, planifica tu viaje y vive experiencias inolvidables en el fin del mundo.'
  : 'Find incredible destinations, plan your trip and live unforgettable experiences at the end of the world.';

const categories = [
  {
    id: 'arte-cultura',
    title: lang === 'es' ? 'Arte y Cultura' : 'Art & Culture',
    img: 'https://images.unsplash.com/photo-1531243269054-5ebf6f34081e?auto=format&fit=crop&q=80&w=800',
    emoji: '🎨',
  },
  {
    id: 'gastronomia',
    title: lang === 'es' ? 'Gastronomía' : 'Gastronomy',
    img: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&q=80&w=800',
    emoji: '🍷',
  },
  {
    id: 'naturaleza-aventura',
    title: lang === 'es' ? 'Naturaleza y Aventura' : 'Nature & Adventure',
    img: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?auto=format&fit=crop&q=80&w=800',
    emoji: '🏔️',
  },
  {
    id: 'ocio-vida-nocturna',
    title: lang === 'es' ? 'Ocio y Vida Nocturna' : 'Leisure & Nightlife',
    img: 'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&q=80&w=800',
    emoji: '🌙',
  },
];
---

<Layout title={pageTitle} lang={lang as 'es' | 'en'}>

  <!-- ═══════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════ -->
  <section class="hero">

    <!-- Blobs decorativos -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>

    <!-- Cuadrícula de fondo -->
    <div class="hero-grid"></div>

    <div class="hero-inner">

      <h1 class="hero-title">
        <span class="title-eyebrow">{lang === 'es' ? 'Bienvenido a' : 'Welcome to'}</span>
        <span class="title-main">Recorre <em>Santiago</em></span>
      </h1>

      <!-- Subtítulo -->
      <p class="hero-subtitle">{subtitle}</p>

      <!-- CTAs -->
      <div class="hero-actions">
        <a href={`/${lang}/descubre`} class="btn btn-primary" id="hero-cta-explorar">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          {lang === 'es' ? 'Explorar Destinos' : 'Explore Destinations'}
        </a>
        <a href={`/${lang}/planifica/itinerarios`} class="btn btn-ghost" id="hero-cta-itinerarios">
          {lang === 'es' ? 'Ver Itinerarios' : 'View Itineraries'}
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>



    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <div class="scroll-line"></div>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════
       CATEGORÍAS
       ═══════════════════════════════════════════ -->
  <section class="categories-section">
    <div class="section-header">
      <h2>{t('nav.descubre')}</h2>
      <p>{lang === 'es' ? 'Explora por categorías y encuentra lo que más te apasiona.' : 'Explore by category and find what you love most.'}</p>
    </div>

    <div class="grid-container">
      {categories.map((cat, index) => {
        const isLarge = index === 0 || index === 3;
        return (
          <a href={`/${lang}/descubre/${cat.id}`} class={`card ${isLarge ? 'card-large' : ''}`}>
            <img
              src={cat.img}
              alt={cat.title}
              class="card-img"
              loading="lazy"
            />
            <div class="card-overlay">
              <span class="card-emoji">{cat.emoji}</span>
              <h2>{cat.title}</h2>
            </div>
          </a>
        );
      })}
    </div>
  </section>

</Layout>

<style>
  /* ─── HERO ─────────────────────────────────────────────── */

  /* Neutralizar el padding-top del main para que el hero sea
     full-bleed desde el tope de la pantalla */
  :global(main:has(.hero)) {
    padding-top: 0 !important;
  }

  .hero {
    min-height: 100vh;
    background-image: linear-gradient(rgba(6, 13, 30, 0.4), rgba(6, 13, 30, 0.65)), url('/santiago_hero_bg.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    padding: 8rem 1.5rem 6rem;   /* top padding compensa el nav fijo */
  }

  /* Cuadrícula sutil */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  /* Blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .blob-1 {
    width: 650px; height: 650px;
    background: radial-gradient(circle, rgba(225,29,72,0.55), transparent 65%);
    top: -180px; right: -120px;
    animation: blobFloat 11s ease-in-out infinite alternate;
  }
  .blob-2 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, rgba(29,78,216,0.45), transparent 65%);
    bottom: -120px; left: -100px;
    animation: blobFloat 14s ease-in-out infinite alternate-reverse;
  }
  .blob-3 {
    width: 320px; height: 320px;
    background: radial-gradient(circle, rgba(124,58,237,0.3), transparent 65%);
    top: 45%; left: 52%;
    transform: translateX(-50%);
    animation: blobFloat 9s ease-in-out infinite alternate;
  }
  @keyframes blobFloat {
    from { transform: translateY(0) scale(1); }
    to   { transform: translateY(50px) scale(1.1); }
  }

  /* Contenido */
  .hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 820px;
    width: 100%;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    color: rgba(255,255,255,0.75);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    margin-bottom: 2.25rem;
    backdrop-filter: blur(10px);
    animation: fadeUp 1.4s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #e11d48;
    box-shadow: 0 0 8px rgba(225,29,72,0.8);
    animation: dotPulse 2s ease infinite;
    flex-shrink: 0;
  }
  @keyframes dotPulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 8px rgba(225,29,72,0.8); }
    50% { opacity: 0.4; box-shadow: 0 0 4px rgba(225,29,72,0.3); }
  }

  /* Título */
  .hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 0 2rem;
    line-height: 1;
    gap: 0.5rem;
  }
  .title-eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: clamp(0.7rem, 1.8vw, 0.95rem);
    font-weight: 500;
    color: rgba(255,255,255,0.45);
    letter-spacing: 0.4em;
    text-transform: uppercase;
    animation: fadeUp 1.4s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .title-main {
    font-family: 'Playfair Display', Georgia, serif !important;
    font-size: clamp(4.5rem, 13vw, 10rem) !important;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #ffffff !important;
    line-height: 1.05;
    white-space: nowrap;
    text-shadow: 0 0 120px rgba(225,29,72,0.5), 0 0 40px rgba(225,29,72,0.2);
    animation: fadeUp 1.4s 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .title-main em {
    font-style: italic;
    background: linear-gradient(90deg, #fb7185 0%, #e11d48 45%, #fb7185 100%) !important;
    background-size: 200% auto !important;
    -webkit-background-clip: text !important;
    background-clip: text !important;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
    animation: shimmer 4s linear infinite;
  }
  @keyframes shimmer {
    to { background-position: 200% center; }
  }

  /* Subtítulo */
  .hero-subtitle {
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: rgba(255,255,255,0.50);
    max-width: 580px;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
    animation: fadeUp 1.4s 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* CTAs */
  .hero-actions {
    display: flex;
    gap: 0.875rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
    animation: fadeUp 1.4s 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
    white-space: nowrap;
  }
  .btn-primary {
    background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
    color: #fff;
    box-shadow: 0 4px 20px rgba(225,29,72,0.40);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(225,29,72,0.55);
  }
  .btn-ghost {
    background: rgba(255,255,255,0.07);
    color: rgba(255,255,255,0.80);
    border: 1px solid rgba(255,255,255,0.14);
    backdrop-filter: blur(8px);
  }
  .btn-ghost:hover {
    background: rgba(255,255,255,0.14);
    color: #fff;
    transform: translateY(-3px);
  }

  /* Stats */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    animation: fadeUp 1.4s 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
  }
  .stat-number {
    font-size: 1.8rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stat-label {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.38);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
    line-height: 1;
    margin-top: 0.2rem;
  }
  .stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(255,255,255,0.10);
    flex-shrink: 0;
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, rgba(225,29,72,0.8), transparent);
    animation: scrollAnim 2.2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes scrollAnim {
    0%   { transform: scaleY(0); opacity: 0; transform-origin: top; }
    45%  { transform: scaleY(1); opacity: 1; transform-origin: top; }
    55%  { transform: scaleY(1); opacity: 1; transform-origin: bottom; }
    100% { transform: scaleY(0); opacity: 0; transform-origin: bottom; }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── CATEGORÍAS ─────────────────────────────────────── */
  .categories-section {
    padding: 6rem 1.5rem 7rem;
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
  }
  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .section-header h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .section-header p {
    color: var(--text-secondary);
    font-size: clamp(0.95rem, 2vw, 1.1rem);
    font-family: 'Outfit', sans-serif;
    font-weight: 400;
    opacity: 0.85;
    letter-spacing: 0.02em;
  }

  .grid-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 4/3;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5, 10, 25, 0.85) 0%, rgba(5, 10, 25, 0.2) 60%, transparent 100%);
    z-index: 1;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.65), 0 0 50px rgba(225, 29, 72, 0.12);
  }
  .card:hover::before {
    opacity: 0.95;
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
  }
  .card:hover .card-img {
    transform: scale(1.08);
  }
  .card-overlay {
    position: absolute;
    bottom: 1.5rem; left: 1.5rem; right: 1.5rem;
    padding: 1.5rem;
    background: rgba(10, 15, 30, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    z-index: 2;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card-overlay {
    transform: translateY(-4px);
    background: rgba(10, 15, 30, 0.85);
    border-color: rgba(225, 29, 72, 0.35);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.4);
  }
  .card-emoji {
    font-size: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    margin-bottom: 0.75rem;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                background-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.5s cubic-bezier(0.16, 1, 0.3, 1),
                box-shadow 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .card:hover .card-emoji {
    transform: scale(1.1) rotate(6deg);
    background: rgba(225, 29, 72, 0.18);
    border-color: rgba(225, 29, 72, 0.45);
    box-shadow: 0 0 15px rgba(225, 29, 72, 0.25);
  }
  .card-overlay h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.3;
    margin: 0;
    color: #fff;
    transition: color 0.3s ease;
  }
  .card:hover .card-overlay h2 {
    color: #fb7185;
  }

  @media (min-width: 640px) {
    .grid-container {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
    .card { aspect-ratio: 1; }
    .card-large {
      grid-column: span 2;
      aspect-ratio: 21/9;
    }
    .card-large .card-overlay h2 {
      font-size: 2rem;
    }
  }


  @media (max-width: 639px) {
    .hero-stats {
      gap: 1.25rem;
    }
    .stat-divider { height: 28px; }
    .stat-number { font-size: 1.5rem; }
  }
</style>
