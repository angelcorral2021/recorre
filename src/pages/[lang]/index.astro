---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, ui } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as keyof typeof ui);
---

<Layout title={t('nav.home')}>
  <div class="relative w-full h-[70vh] min-h-[500px] flex items-center justify-center overflow-hidden">
    <!-- Imagen de fondo con overlay -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/santiago-cover.png" 
        alt="Santiago de Chile" 
        class="w-full h-full object-cover object-center"
      />
      <!-- Gradiente superpuesto para legibilidad -->
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-[var(--background)]"></div>
    </div>

    <!-- Contenido del Hero -->
    <div class="relative z-10 container mx-auto px-4 flex flex-col items-center text-center text-white">
      <h1 class="text-6xl md:text-8xl font-bold mb-6 tracking-tight drop-shadow-lg">
        Explora <span class="text-blue-400 italic font-medium">Santiago</span>
      </h1>
      <p class="text-xl md:text-2xl font-light opacity-90 max-w-2xl mb-10 drop-shadow-md">
        La guía definitiva para descubrir el arte, cultura y gastronomía de Chile.
      </p>
      <a href={`/${lang}/descubre`} class="bg-blue-600 hover:bg-blue-500 text-white font-semibold tracking-wide py-4 px-10 rounded-full transition-all shadow-xl hover:shadow-2xl transform hover:-translate-y-1 backdrop-blur-sm">
        {t('nav.descubre')}
      </a>
    </div>
  </div>

  <!-- Sección posterior al Hero -->
  <div class="container mx-auto px-4 py-24 text-center">
    <h2 class="text-4xl md:text-5xl font-bold mb-6">Descubre la Magia del Fin del Mundo</h2>
    <p class="text-lg md:text-xl text-[var(--foreground)]/70 max-w-2xl mx-auto font-light">
      Prepárate para vivir experiencias inolvidables en una de las ciudades más vibrantes de Sudamérica.
    </p>
  </div>
</Layout>
