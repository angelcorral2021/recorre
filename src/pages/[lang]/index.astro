---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } },
    { params: { lang: 'pt' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'es' | 'en');

const pageTitle = { es: 'Inicio', en: 'Home', pt: 'Início' }[lang as string] || 'Home';
const description = {
  es: 'Explora las maravillas que Santiago tiene para ofrecer por categoría.',
  en: 'Explore the wonders Santiago has to offer by category.',
  pt: 'Explore as maravilhas que Santiago tem a oferecer por categoria.'
}[lang as string] || 'Explore the wonders Santiago has to offer by category.';

const subcategories = [
  { id: 'arte-cultura', title: { es: 'Arte y Cultura', en: 'Art & Culture', pt: 'Arte e Cultura' }[lang as string], icon: '<svg width="48" height="48" viewBox="0 0 48 48"><rect x="8" y="8" width="10" height="32" fill="#E03C31"/><rect x="22" y="16" width="10" height="24" fill="#005B9F"/><rect x="36" y="24" width="10" height="16" fill="#F2B705"/></svg>' },
  { id: 'gastronomia', title: { es: 'Gastronomía', en: 'Gastronomy', pt: 'Gastronomia' }[lang as string], icon: '<svg width="48" height="48" viewBox="0 0 48 48"><rect x="8" y="24" width="20" height="20" fill="#F2B705"/><path d="M 20 8 A 16 16 0 0 1 20 40 Z" fill="#FFFFFF" opacity="0.9"/></svg>' },
  { id: 'naturaleza-aventura', title: { es: 'Naturaleza y Aventura', en: 'Nature & Adventure', pt: 'Natureza e Aventura' }[lang as string], icon: '<svg width="48" height="48" viewBox="0 0 48 48"><circle cx="20" cy="20" r="14" fill="#E03C31"/><polygon points="24,14 42,40 6,40" fill="#005B9F" opacity="0.9"/></svg>' },
  { id: 'ocio-vida-nocturna', title: { es: 'Ocio y Vida Nocturna', en: 'Leisure & Nightlife', pt: 'Lazer e Vida Noturna' }[lang as string], icon: '<svg width="48" height="48" viewBox="0 0 48 48"><circle cx="24" cy="24" r="16" fill="#F2B705"/><line x1="8" y1="8" x2="40" y2="40" stroke="#FFFFFF" stroke-width="6"/></svg>' },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Santiago Chile Travel",
  "description": description,
  "url": "https://santiago.travel/"
};
---

<Layout title={`${pageTitle} | RecorreSantiago`} description={description} schema={schema}>
  <!-- ═══════════════════════════════════════════
       HEADER CON MESH GRID Y BLOBS
       ═══════════════════════════════════════════ -->
  <header class="page-header">
    <!-- Blobs decorativos -->
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    
    <!-- Cuadrícula de fondo -->
    <div class="mesh-grid"></div>

    <div class="header-inner container">
      <span class="eyebrow">{lang === 'es' ? 'Sección' : 'Section'}</span>
      <h1 class="header-title">
        {{es: 'Descubre ', en: 'Discover ', pt: 'Descubra '}[lang as string] || 'Discover '}<em>Santiago</em>
      </h1>
      <p class="header-description">{description}</p>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════
       CONTENIDO
       ═══════════════════════════════════════════ -->
  <section class="content-section">
    <div class="container">
      <div class="cards-grid">
        {subcategories.map(sub => (
          <a href={`/${lang}/${sub.id}`} class="section-card">
            <div class="icon-wrapper">
              <span class="icon-bauhaus" set:html={sub.icon} />
            </div>
            <h2>{sub.title}</h2>
            <div class="view-more">
              <span>{{es: 'Ver más', en: 'View more', pt: 'Ver mais'}[lang as string] || 'View more'}</span>
              <svg class="arrow-svg" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  // Añadir efecto interactivo para seguir al cursor con la luz del degradado
  const cards = document.querySelectorAll('.section-card');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e: Event) => {
      const mouseEvent = e as MouseEvent;
      const rect = card.getBoundingClientRect();
      const x = mouseEvent.clientX - rect.left;
      const y = mouseEvent.clientY - rect.top;
      (card as HTMLElement).style.setProperty('--x', `${x}px`);
      (card as HTMLElement).style.setProperty('--y', `${y}px`);
    });
  });
</script>

<style>
  /* Neutralizar padding superior para que el header se integre bien */
  :global(main:has(.page-header)) {
    padding-top: 0 !important;
  }

  /* ─── ENCABEZADO (HERO-HEADER) ────────────────────────────── */
  .page-header {
    background: transparent;
    position: relative;
    overflow: hidden;
    padding: 3.15rem 1.5rem 5.85rem;
    text-align: center;
  }

  /* Cuadrícula sutil */
  .mesh-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 64px 64px;
    pointer-events: none;
  }

  /* Blobs decorativos */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
    opacity: 0.6;
  }
  .blob-1 {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(225, 29, 72, 0.45), transparent 70%);
    top: -50px;
    right: 15%;
    animation: floatBlob 8s ease-in-out infinite alternate;
  }
  .blob-2 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.25), transparent 70%);
    bottom: -50px;
    left: 15%;
    animation: floatBlob 10s ease-in-out infinite alternate-reverse;
  }

  @keyframes floatBlob {
    from { transform: translateY(0px) scale(1); }
    to { transform: translateY(20px) scale(1.05); }
  }

  .header-inner {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
    animation: fadeUp 0.6s ease both;
  }

  .eyebrow {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .header-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .header-title em {
    font-style: italic;
    background: linear-gradient(90deg, #fb7185 0%, #e11d48 50%, #be123c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .header-description {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* ─── CONTENIDO Y TARJETAS ────────────────────────────────── */
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .content-section {
    padding: 5rem 0;
    background: transparent;
    position: relative;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .section-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0; /* Bauhaus */
    padding: 2rem 1.5rem;
    text-align: center;
    text-decoration: none;
    color: #ffffff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .section-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(255, 255, 255, 0.06), transparent 40%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .section-card:hover::before {
    opacity: 1;
  }

  .section-card:hover {
    transform: translateY(-8px);
    border-color: rgba(225, 29, 72, 0.4);
    box-shadow: 0 20px 40px rgba(225, 29, 72, 0.15);
    background: rgba(255, 255, 255, 0.05);
  }

  .icon-wrapper {
    width: 70px;
    height: 70px;
    border-radius: 0; /* Estilo arquitectónico Bauhaus */
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .icon-bauhaus {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-card:hover .icon-wrapper {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.3);
    transform: scale(1.05) rotate(5deg);
  }

  .section-card:hover .icon-bauhaus {
    transform: scale(1.1);
  }

  .section-card h2 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #ffffff;
  }

  .view-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #fb7185;
    font-weight: 600;
    font-size: 0.95rem;
    margin-top: auto;
    transition: color 0.3s;
  }

  .arrow-svg {
    transition: transform 0.3s;
  }

  .section-card:hover .view-more {
    color: #f43f5e;
  }

  .section-card:hover .arrow-svg {
    transform: translateX(5px);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

