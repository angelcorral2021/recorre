      desc: isES ? 'SANFIC es el festival de cine más importante de Chile con más de 100 películas de todo el mundo y secciones de competencia internacional.' : 'SANFIC is Chile\'s most important film festival with over 100 films from around the world and international competition sections.',
      emoji: '🎬',
    },
  ],
  tip: isES ? '💡 Los jueves por la noche son el nuevo viernes en Santiago. Los bares y restaurantes del Barrio Italia y Lastarria se llenan a partir de las 21:00.' : '💡 Thursday nights are the new Friday in Santiago. Bars and restaurants in Barrio Italia and Lastarria fill up from 9pm.',
};

const pageData = id === 'arte-cultura' ? arteCultura
  : id === 'gastronomia' ? gastronomia
  : id === 'naturaleza-aventura' ? naturaleza
  : ocio;

// Textos dinámicos por sección
const sectionSubtitle = {
  'arte-cultura':       isES ? 'Los espacios culturales que definen Santiago' : 'The cultural spaces that define Santiago',
  'gastronomia':        isES ? 'Los sabores y lugares gastronómicos imperdibles' : 'The unmissable flavors and gastronomic spots',
  'naturaleza-aventura':isES ? 'Naturaleza y aventura a las puertas de la ciudad' : 'Nature and adventure at the city gates',
  'ocio-vida-nocturna': isES ? 'Los mejores planes de ocio y entretenimiento' : 'The best leisure and entertainment plans',
}[id] ?? '';

const eventsSubtitle = {
  'arte-cultura':       isES ? 'Santiago celebra la cultura durante todo el año' : 'Santiago celebrates culture all year long',
  'gastronomia':        isES ? 'Ferias, mercados y eventos gastronómicos del año' : 'Food fairs, markets and gastronomic events of the year',
  'naturaleza-aventura':isES ? 'Temporadas, carreras y festivales al aire libre' : 'Seasons, races and outdoor festivals',
  'ocio-vida-nocturna': isES ? 'Los eventos que marcan el calendario de Santiago' : 'The events that mark Santiago\'s calendar',
}[id] ?? '';

const ctaDesc = {
  'arte-cultura':       isES ? 'Planifica tu visita a los espacios culturales de Santiago.' : 'Plan your visit to Santiago\'s cultural spaces.',
  'gastronomia':        isES ? 'Organiza tu ruta gastronómica por Santiago.' : 'Organize your gastronomic route through Santiago.',
  'naturaleza-aventura':isES ? 'Prepara tu próxima aventura en la naturaleza.' : 'Prepare your next nature adventure.',
  'ocio-vida-nocturna': isES ? 'Descubre los mejores planes de ocio en Santiago.' : 'Discover the best leisure plans in Santiago.',
}[id] ?? '';
---

<Layout title={`${title} | Inicio | RecorreSantiago`} lang={lang as 'es' | 'en'}>

  <!-- HERO -->
  <div class="cat-hero" style={`background-image: url('${pageData.hero.img}')`}>
    <div class="cat-hero-overlay"></div>
    <div class="cat-hero-inner">
      <a href={`/${lang}/`} class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {isES ? 'Descubre' : 'Discover'}
      </a>
      <h1>{title}</h1>
      <p>{pageData.hero.subtitle}</p>
    </div>
  </div>

  {(id === 'arte-cultura' || id === 'gastronomia' || id === 'naturaleza-aventura' || id === 'ocio-vida-nocturna') && (
    <div class="page-body">

      <!-- TIP BANNER -->
      <div class="tip-banner container">
        <span>{pageData.tip}</span>
      </div>

      <!-- HIGHLIGHTS -->
      <section class="section container">
        <div class="section-head">
          <h2>{isES ? 'Lugares imprescindibles' : 'Must-see places'}</h2>
          <p>{sectionSubtitle}</p>
        </div>
        <div class="cards-grid">
          {pageData.highlights.map(place => (
            <article class="place-card">
              <div class="place-img-wrap">
                <img src={place.img} alt={place.name} loading="lazy" />
                <span class="place-emoji">{place.emoji}</span>
              </div>
              <div class="place-info">
                <span class="place-tag">{place.tag}</span>
                <h3>{place.name}</h3>
                <p>{place.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- EVENTS -->
      <section class="section events-section">
        <div class="container">
          <div class="section-head">
            <h2>{isES ? 'Eventos y festivales' : 'Events & festivals'}</h2>
            <p>{eventsSubtitle}</p>
          </div>
          <div class="events-grid">
            {pageData.events.map(ev => (
              <div class="event-card">
                <span class="event-emoji">{ev.emoji}</span>
                <div>
                  <span class="event-date">{ev.date}</span>
                  <h3>{ev.name}</h3>
                  <p>{ev.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- CTA -->
      <div class="cta-section container">
        <h2>{isES ? '¿Listo para explorar?' : 'Ready to explore?'}</h2>
        <p>{ctaDesc}</p>
        <div class="cta-actions">
          <a href={`/${lang}/planifica/itinerarios`} class="btn-primary">{isES ? 'Ver itinerarios' : 'View itineraries'}</a>
          <a href={`/${lang}/`} class="btn-ghost">{isES ? 'Seguir explorando' : 'Keep exploring'}</a>
        </div>
      </div>

    </div>
  )}



</Layout>

<style>
  /* HERO */
  .cat-hero {
    min-height: 55vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    position: relative;
  }
  .cat-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5,10,25,0.92) 0%, rgba(5,10,25,0.4) 60%, transparent 100%);
  }
  .cat-hero-inner {
    position: relative;
    z-index: 1;
    padding: 3rem 1.5rem 3.5rem;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255,255,255,0.6);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 1.25rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: #fff; }
  .cat-hero-inner h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 1rem;
    letter-spacing: -0.03em;
  }
  .cat-hero-inner p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255,255,255,0.7);
    max-width: 600px;
    line-height: 1.7;
  }

  /* BODY */
  .page-body { background: var(--bg-color); }

  /* TIP */
  .tip-banner {
    background: linear-gradient(135deg, #fff7ed, #ffe4e6);
    border: 1px solid #fecaca;
    border-radius: 14px;
    padding: 1rem 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 0;
    color: #9f1239;
    font-weight: 500;
    font-size: 0.95rem;
  }

  /* CONTAINER */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* SECTIONS */
  .section { padding: 4rem 0; }
  .section-head {
    text-align: center;
    margin-bottom: 3rem;
  }
  .section-head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .section-head p {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  /* CARDS GRID */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }
  .place-card {
    background: var(--surface-color);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .place-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px -10px rgba(0,0,0,0.12);
  }
  .place-img-wrap {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .place-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .place-card:hover .place-img-wrap img { transform: scale(1.05); }
  .place-emoji {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    font-size: 1.5rem;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border-radius: 10px;
    padding: 0.3rem 0.5rem;
    line-height: 1;
  }
  .place-info { padding: 1.25rem 1.5rem 1.5rem; }
  .place-tag {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-primary);
    background: rgba(225,29,72,0.07);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .place-info h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }
  .place-info p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  /* EVENTS */
  .events-section { background: #0f172a; }
  .events-section .section-head h2 { color: #fff; }
  .events-section .section-head p { color: rgba(255,255,255,0.5); }
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .event-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    padding: 1.5rem;
    transition: background 0.2s;
  }
  .event-card:hover { background: rgba(255,255,255,0.08); }
  .event-emoji {
    font-size: 2rem;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 0.1rem;
  }
  .event-date {
    display: block;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fb7185;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }
  .event-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }
  .event-card p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.6;
  }

  /* CTA */
  .cta-section {
    text-align: center;
    padding: 5rem 1.5rem;
  }
  .cta-section h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }
  .cta-section p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    background: linear-gradient(135deg, #e11d48, #be123c);
    color: #fff;
    box-shadow: 0 4px 20px rgba(225,29,72,0.35);
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(225,29,72,0.5);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.975rem;
    text-decoration: none;
    border: 1.5px solid var(--border-color);
    color: var(--text-primary);
    transition: all 0.2s;
  }
  .btn-ghost:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* COMING SOON */
  .coming-soon {
    text-align: center;
    padding: 6rem 1.5rem;
    color: var(--text-secondary);
    font-size: 1.1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 640px) {
    .cards-grid { grid-template-columns: 1fr; }
    .events-grid { grid-template-columns: 1fr; }
  }
</style>

