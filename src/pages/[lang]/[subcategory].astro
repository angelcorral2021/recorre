---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';
import { placesData } from '../../data/places';

export function getStaticPaths() {
  const langs = ['es', 'en', 'pt'];
  const subcategories = [
    { id: 'arte-cultura', es: 'Arte y Cultura', en: 'Art & Culture', pt: 'Arte e Cultura' },
    { id: 'gastronomia', es: 'Gastronomía', en: 'Gastronomy', pt: 'Gastronomia' },
    { id: 'naturaleza-aventura', es: 'Naturaleza y Aventura', en: 'Nature & Adventure', pt: 'Natureza e Aventura' },
    { id: 'ocio-vida-nocturna', es: 'Ocio y Vida Nocturna', en: 'Leisure & Nightlife', pt: 'Lazer e Vida Noturna' },
  ];
  return langs.flatMap(lang =>
    subcategories.map(sub => ({
      params: { lang, subcategory: sub.id },
      props: { title: sub[lang as 'es'|'en'], id: sub.id }
    }))
  );
}

const { lang, subcategory: id } = Astro.params;
const { title } = Astro.props;
const t = useTranslations(lang as 'es' | 'en');
const isES = lang === 'es';

const loc = (obj: any) => obj?.[lang as keyof typeof obj] || obj?.en || '';

const pageData = placesData[id];

// Textos dinámicos por sección
const sectionSubtitle = {
  'arte-cultura':       isES ? 'Los espacios culturales que definen Santiago' : 'The cultural spaces that define Santiago',
  'gastronomia':        isES ? 'Los sabores y lugares gastronómicos imperdibles' : 'The unmissable flavors and gastronomic spots',
  'naturaleza-aventura':isES ? 'Naturaleza y aventura a las puertas de la ciudad' : 'Nature and adventure at the city gates',
  'ocio-vida-nocturna': isES ? 'Los mejores planes de ocio y entretenimiento' : 'The best leisure and entertainment plans',
}[id] ?? '';

const eventsSubtitle = {
  'arte-cultura':       isES ? 'Santiago celebra la cultura durante todo el año' : 'Santiago celebrates culture all year long',
  'gastronomia':        isES ? 'Ferias, mercados y eventos gastronómicos del año' : 'Food fairs, markets and gastronomic events of the year',
  'naturaleza-aventura':isES ? 'Temporadas, carreras y festivales al aire libre' : 'Seasons, races and outdoor festivals',
  'ocio-vida-nocturna': isES ? 'Los eventos que marcan el calendario de Santiago' : 'The events that mark Santiago\'s calendar',
}[id] ?? '';

const ctaDesc = {
  'arte-cultura':       isES ? 'Planifica tu visita a los espacios culturales de Santiago.' : 'Plan your visit to Santiago\'s cultural spaces.',
  'gastronomia':        isES ? 'Organiza tu ruta gastronómica por Santiago.' : 'Organize your gastronomic route through Santiago.',
  'naturaleza-aventura':isES ? 'Prepara tu próxima aventura en la naturaleza.' : 'Prepare your next nature adventure.',
  'ocio-vida-nocturna': isES ? 'Descubre los mejores planes de ocio en Santiago.' : 'Discover the best leisure plans in Santiago.',
}[id] ?? '';
---

<Layout title={`${title} | Inicio | RecorreSantiago`} lang={lang as 'es' | 'en'}>

  <!-- HERO -->
  <div class="cat-hero" style={`background-image: url('${pageData.hero.img}')`}>
    <div class="cat-hero-overlay"></div>
    <div class="cat-hero-inner">
      <a href={`/${lang}/`} class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {{es: 'Descubre', en: 'Discover', pt: 'Descubra'}[lang as string] || 'Discover'}
      </a>
      <h1>{title}</h1>
      <p>{loc(pageData.hero.subtitle)}</p>
    </div>
  </div>

  {(id === 'arte-cultura' || id === 'gastronomia' || id === 'naturaleza-aventura' || id === 'ocio-vida-nocturna') && (
    <div class="page-body">

      <!-- HIGHLIGHTS -->
      <section class="section container">
        <div class="section-head">
          <h2>{{es: 'Lugares imprescindibles', en: 'Must-see places', pt: 'Lugares imperdíveis'}[lang as string] || 'Must-see places'}</h2>
          <p>{sectionSubtitle}</p>
        </div>
        <div class="cards-grid">
          {pageData.places.map(place => (
            <a href={`/${lang}/lugar/${place.id}`} class="place-card">
              <div class="place-img-wrap">
                <img src={place.img} alt={loc(place.name)} loading="lazy" />
              </div>
              <div class="place-info">
                <span class="place-tag">{loc(place.tag)}</span>
                <h3>{loc(place.name)}</h3>
                <p>{loc(place.shortDesc)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>


    </div>
  )}

</Layout>

<style>
  /* HERO */
  .cat-hero {
    min-height: 55vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
    position: relative;
  }
  .cat-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(5,10,25,0.92) 0%, rgba(5,10,25,0.4) 60%, transparent 100%);
  }
  .cat-hero-inner {
    position: relative;
    z-index: 1;
    padding: 3rem 1.5rem 3.5rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    text-align: left;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    margin-bottom: 1.5rem;
    transition: color 0.3s;
  }
  .back-link:hover { color: #ffffff; }
  .cat-hero-inner h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .cat-hero-inner p {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: rgba(255,255,255,0.7);
    max-width: 700px;
    line-height: 1.7;
  }

  /* BODY */
  .page-body { background: var(--bg-color); }


  /* CONTAINER */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* SECTION */
  .section {
    padding: 5rem 0;
  }
  .section-head {
    margin-bottom: 3rem;
  }
  .section-head h2 {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    color: var(--text-color);
    margin-bottom: 0.5rem;
  }
  .section-head p {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* CARDS GRID */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
  }
  .place-card {
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 0;
    overflow: hidden;
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: #ffffff;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s;
  }
  .place-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.3);
    border-color: rgba(225, 29, 72, 0.4);
  }
  .place-img-wrap {
    width: 100%;
    height: 220px;
    position: relative;
    overflow: hidden;
  }
  .place-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .place-card:hover .place-img-wrap img { transform: scale(1.05); }
  .place-info { padding: 1.25rem 1.5rem 1.5rem; }
  .place-tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #f43f5e;
    margin-bottom: 0.5rem;
  }
  .place-info h3 {
    font-family: 'Outfit', sans-serif;
    font-size: 1.3rem;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }
  .place-info p {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.5;
  }

</style>
