import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/ui';

export function getStaticPaths() {
  const langs = ['es', 'en'];
  const subcategories = [
    { id: 'arte-cultura', es: 'Arte y Cultura', en: 'Art & Culture' },
    { id: 'gastronomia', es: 'Gastronomía', en: 'Gastronomy' },
    { id: 'naturaleza-aventura', es: 'Naturaleza y Aventura', en: 'Nature & Adventure' },
    { id: 'ocio-vida-nocturna', es: 'Ocio y Vida Nocturna', en: 'Leisure & Nightlife' },
  ];
  return langs.flatMap(lang =>
    subcategories.map(sub => ({
      params: { lang, subcategory: sub.id },
      props: { title: sub[lang as 'es'|'en'], id: sub.id }
    }))
  );
}

