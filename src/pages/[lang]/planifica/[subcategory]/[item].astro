---
import Layout from '../../../../layouts/Layout.astro';
import { planificaData } from '../../../../data/planifica';

export function getStaticPaths() {
  const langs = ['es', 'en', 'pt'];
  
  return langs.flatMap(lang => 
    planificaData.flatMap(category => 
      category.sections.flatMap(section => 
        section.items.map(item => ({
          params: { lang, subcategory: category.id, item: item.slug },
          props: { category, section, item }
        }))
      )
    )
  );
}

const { lang, subcategory } = Astro.params;
const { category, section, item } = Astro.props;

const loc = (obj: any) => obj?.[lang as keyof typeof obj] || obj?.en || '';
const title = loc(item.title);
const content = loc(item.content);
---
<Layout title={`${title} | RecorreSantiago`} lang={lang as 'es' | 'en'}>
  
  <div class="page-hero" style={`background-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.9)), url('${category.heroImg}')`}>
    <div class="container hero-top">
      <a href={`/${lang}/planifica/${subcategory}`} class="back-link">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {lang === 'es' ? 'Volver atrás' : lang === 'pt' ? 'Voltar' : 'Go back'}
      </a>
    </div>
    <div class="container hero-content">
      <h1>{title}</h1>
      <p>{loc(item.desc)}</p>
    </div>
  </div>

  <article class="content-section">
    <div class="container rich-text" set:html={content} />
  </article>

</Layout>

<style>
  /* HERO */
  .page-hero {
    min-height: 12vh;
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding-bottom: 1rem;
    padding-top: 5rem;
  }
  .hero-top {
    position: absolute;
    top: 6rem; /* A bit below the transparent navbar */
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 1200px;
    z-index: 10;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 100%;
    max-width: 800px !important;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
    background: rgba(0,0,0,0.3);
    padding: 0.5rem 1rem;
    border-radius: 8px;
    backdrop-filter: blur(4px);
  }
  .back-link:hover {
    color: white;
  }
  .page-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
    line-height: 1.1;
  }
  .page-hero p {
    font-size: 1.25rem;
    color: rgba(255,255,255,0.8);
    max-width: 600px;
  }

  /* LAYOUT */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }
  .content-section {
    padding-block: 5rem;
    position: relative;
    background: var(--bg-color);
  }

  /* RICH TEXT FORMATTING */
  .rich-text {
    max-width: 800px;
    margin: 0 auto;
    color: var(--text-color);
    font-size: 1.15rem;
    line-height: 1.8;
  }

  /* This :global() is needed because the HTML is injected via set:html */
  :global(.rich-text h3) {
    font-family: 'Outfit', sans-serif;
    font-size: 1.8rem;
    color: #ffffff;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  
  :global(.rich-text p) {
    margin-bottom: 1.5rem;
    color: rgba(255,255,255,0.8);
  }

  :global(.rich-text ul) {
    margin-bottom: 2rem;
    padding-left: 1.5rem;
    color: rgba(255,255,255,0.8);
  }

  :global(.rich-text li) {
    margin-bottom: 0.75rem;
  }

  :global(.rich-text strong) {
    color: #ffffff;
    font-weight: 600;
  }

  /* TIP BOX (Glassmorphism inside article) */
  :global(.rich-text .tip-box) {
    margin-top: 3rem;
    margin-bottom: 2rem;
    padding: 2rem;
    background: rgba(2, 132, 199, 0.1);
    border: 1px solid rgba(2, 132, 199, 0.3);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
  }
  :global(.rich-text .tip-box::before) {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0; width: 4px;
    background: #38bdf8;
  }
  :global(.rich-text .tip-box h4) {
    font-family: 'Outfit', sans-serif;
    color: #38bdf8;
    margin-bottom: 1rem;
    font-size: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  :global(.rich-text .tip-box p) {
    margin-bottom: 0;
    font-size: 1.05rem;
    color: rgba(255,255,255,0.9);
  }
</style>
